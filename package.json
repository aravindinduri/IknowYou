{
  "name": "ai-knowledge-inbox",
  "version": "1.0.0",
  "description": "Minimal AI Knowledge Inbox with server-side ingestion, vector store, and RAG pipeline",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install"
  },
  "keywords": [
    "rag",
    "vector-search",
    "express",
    "react",
    "huggingface",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@huggingface/inference": "^3.3.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sql.js": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
